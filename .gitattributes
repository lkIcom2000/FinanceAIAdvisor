# Normalise line endings; config, data and models are hashed into the config fingerprint (AD-14), so they are LF.
* text=auto
config/** text eol=lf
data/** text eol=lf
models/** text eol=lf
frontend/openapi/** text eol=lf
backend/mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.gguf binary
*.pdf binary
*.png binary
