# Copy to deploy/.env (git-ignored) and fill in. Secrets come only from here or the shell environment.
# Owner role (Flyway, database container) and the application role fine_app. No single quotes.
FINE_DB_PASSWORD=change-me
FINE_APP_DB_PASSWORD=change-me-too

# Optional overrides; defaults are in docker-compose.yml.
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fine
# SPRING_DATASOURCE_USERNAME=fine_app
# SPRING_DATASOURCE_OWNER_USERNAME=fine
# APP_OLLAMA_URL=http://ollama:11434
# APP_AGENT_CONFIG=reference
# SPRING_PROFILES_ACTIVE=default
