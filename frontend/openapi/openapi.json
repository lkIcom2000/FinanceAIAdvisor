{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Fine API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "description" : "Where a figure comes from",
    "name" : "provenance"
  }, {
    "description" : "Session login",
    "name" : "auth"
  }, {
    "description" : "The Financial Overview",
    "name" : "overview"
  }, {
    "description" : "The persona of the session",
    "name" : "persona"
  } ],
  "paths" : {
    "/api/auth/csrf" : {
      "get" : {
        "operationId" : "csrf",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Issue the XSRF-TOKEN cookie; call once before the first state-changing request",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionInfo"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Log in with username and password; starts a session",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "End the session",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionInfo"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The logged-in account",
        "tags" : [ "auth" ]
      }
    },
    "/api/overview/home" : {
      "get" : {
        "operationId" : "home",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HomeOverview"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The Home tab's summary figures",
        "tags" : [ "overview" ]
      }
    },
    "/api/persona" : {
      "get" : {
        "operationId" : "current",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PersonaResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The persona of the current session",
        "tags" : [ "persona" ]
      }
    },
    "/api/provenance/{provId}" : {
      "get" : {
        "operationId" : "show",
        "parameters" : [ {
          "description" : "16 lower-case hex characters",
          "in" : "path",
          "name" : "provId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProvenanceResponse"
                }
              }
            },
            "description" : "The figure's provenance"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProvenanceResponse"
                }
              }
            },
            "description" : "Not a figure key"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProvenanceResponse"
                }
              }
            },
            "description" : "No such figure for this persona"
          }
        },
        "summary" : "Where a figure comes from: source, inputs, assumptions and checks",
        "tags" : [ "provenance" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "Figure" : {
        "type" : "object",
        "description" : "A figure from Fine's calculation engine with the key of its provenance",
        "properties" : {
          "label" : {
            "type" : "string"
          },
          "provId" : {
            "type" : "string",
            "pattern" : "^[0-9a-f]{16}$"
          },
          "unit" : {
            "type" : "string",
            "enum" : [ "EUR", "FRACTION", "PP", "MONTHS", "YEARS", "COUNT" ]
          },
          "value" : {
            "type" : "string",
            "description" : "Decimal string",
            "example" : "1974.00",
            "pattern" : "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required" : [ "label", "provId", "unit", "value" ]
      },
      "HomeOverview" : {
        "type" : "object",
        "properties" : {
          "currentAccount" : {
            "$ref" : "#/components/schemas/Figure"
          }
        },
        "required" : [ "currentAccount" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "password" : {
            "type" : "string",
            "minLength" : 1
          },
          "username" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "password", "username" ]
      },
      "Money" : {
        "type" : "object",
        "description" : "An amount of money: decimal string with two fraction digits plus currency.",
        "properties" : {
          "amount" : {
            "type" : "string",
            "example" : "1234.50",
            "pattern" : "^-?\\d+\\.\\d{2}$"
          },
          "currency" : {
            "type" : "string",
            "enum" : [ "EUR" ]
          }
        },
        "required" : [ "amount", "currency" ]
      },
      "PersonaResponse" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "today" : {
            "type" : "string",
            "format" : "date",
            "description" : "The persona's simulated date; present only under the research profile"
          }
        },
        "required" : [ "displayName", "id" ]
      },
      "ProblemCode" : {
        "type" : "string",
        "description" : "Closed set of machine-readable error codes.",
        "enum" : [ "VALIDATION_FAILED", "BAD_CREDENTIALS", "UNAUTHENTICATED", "FORBIDDEN", "NOT_FOUND", "REQUEST_REJECTED", "INTERNAL_ERROR" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "RFC 9457 problem details with a closed code.",
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ProblemCode"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "code", "status", "title" ]
      },
      "ProvenanceCheck" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "passed" : {
            "type" : "boolean"
          }
        },
        "required" : [ "description", "id", "passed" ]
      },
      "ProvenanceInput" : {
        "type" : "object",
        "properties" : {
          "label" : {
            "type" : "string"
          },
          "provId" : {
            "type" : "string",
            "description" : "The input's own figure key, where it is itself a figure"
          },
          "text" : {
            "type" : "string",
            "description" : "Absent for a number input"
          },
          "unit" : {
            "type" : "string",
            "description" : "Absent for a text input",
            "enum" : [ "EUR", "FRACTION", "PP", "MONTHS", "YEARS", "COUNT" ]
          },
          "value" : {
            "type" : "string",
            "description" : "Decimal string; absent for a text input",
            "pattern" : "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required" : [ "label" ]
      },
      "ProvenanceResponse" : {
        "type" : "object",
        "properties" : {
          "asOf" : {
            "type" : "string",
            "format" : "date"
          },
          "assumptions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "checks" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ProvenanceCheck"
            }
          },
          "inputs" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ProvenanceInput"
            }
          },
          "label" : {
            "type" : "string"
          },
          "provId" : {
            "type" : "string",
            "pattern" : "^[0-9a-f]{16}$"
          },
          "ruleParameters" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ProvenanceRuleParameter"
            }
          },
          "source" : {
            "$ref" : "#/components/schemas/ProvenanceSource"
          },
          "unit" : {
            "type" : "string",
            "enum" : [ "EUR", "FRACTION", "PP", "MONTHS", "YEARS", "COUNT" ]
          },
          "value" : {
            "type" : "string",
            "description" : "Decimal string",
            "pattern" : "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required" : [ "asOf", "assumptions", "checks", "inputs", "label", "provId", "ruleParameters", "source", "unit", "value" ]
      },
      "ProvenanceRuleParameter" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "validFrom" : {
            "type" : "string",
            "format" : "date",
            "description" : "First day this version applies; absent if unknown"
          },
          "validTo" : {
            "type" : "string",
            "format" : "date",
            "description" : "Last day this version applies; absent if open-ended"
          },
          "version" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "version" ]
      },
      "ProvenanceSource" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "CORE_FUNCTION", "RULE_PARAMETER", "KB_CITATION" ]
          }
        },
        "required" : [ "description", "kind" ]
      },
      "SessionInfo" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "PERSONA", "ADVISOR", "RESEARCHER" ]
          }
        },
        "required" : [ "displayName", "role" ]
      }
    }
  }
}
