{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Fine API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "description" : "Where a figure comes from",
    "name" : "provenance"
  }, {
    "description" : "Session login",
    "name" : "auth"
  }, {
    "description" : "The Financial Overview",
    "name" : "overview"
  }, {
    "description" : "The chat with Fine",
    "name" : "chat"
  }, {
    "description" : "The persona of the session",
    "name" : "persona"
  } ],
  "paths" : {
    "/api/auth/csrf" : {
      "get" : {
        "operationId" : "csrf",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Issue the XSRF-TOKEN cookie; call once before the first state-changing request",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionInfo"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Log in with username and password; starts a session",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "End the session",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionInfo"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The logged-in account",
        "tags" : [ "auth" ]
      }
    },
    "/api/chat" : {
      "get" : {
        "operationId" : "chat",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Chat"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The conversation with every saved message",
        "tags" : [ "chat" ]
      }
    },
    "/api/chat/messages" : {
      "post" : {
        "operationId" : "postMessage",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PostMessageRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "The saved question"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "Blank or longer than 1,000 characters"
          }
        },
        "summary" : "Save a question; answer it with the answer call",
        "tags" : [ "chat" ]
      }
    },
    "/api/chat/messages/{id}/answer" : {
      "post" : {
        "description" : "A question that already has an answer returns that answer again.",
        "operationId" : "answerMessage",
        "parameters" : [ {
          "description" : "The question's id (a UUID)",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "Fine's answer"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "No such question for this persona"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "The answer could not be finished; the question stays saved"
          }
        },
        "summary" : "Run the turn for a saved question and return Fine's complete answer",
        "tags" : [ "chat" ]
      }
    },
    "/api/chat/messages/{id}/assessment" : {
      "post" : {
        "description" : "The answers are stored only by this call, through the profile confirm control. A card that was already saved returns that answer again.",
        "operationId" : "saveAssessment",
        "parameters" : [ {
          "description" : "The card's id (a UUID)",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SaveAssessmentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "Fine's answer to the question the card was opened for"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "An answer is missing, not on the card or does not fit"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "No such assessment card for this persona"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "The card was cancelled by a later question"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "The answer could not be finished; nothing is stored and the card stays open"
          }
        },
        "summary" : "Save my answers on an assessment card and return Fine's answer to the original question",
        "tags" : [ "chat" ]
      }
    },
    "/api/chat/messages/{id}/calculate" : {
      "post" : {
        "description" : "Nothing is calculated before this call. A proposal that was already calculated returns that answer again.",
        "operationId" : "calculate",
        "parameters" : [ {
          "description" : "The proposal's id (a UUID)",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CalculateRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "Fine's calculated answer"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "A changed value is unknown or out of bounds"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "No such proposal for this persona"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "The proposal was cancelled by a later question"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "The answer could not be finished; the proposal stays open"
          }
        },
        "summary" : "Calculate a parameter proposal and return Fine's calculated answer",
        "tags" : [ "chat" ]
      }
    },
    "/api/overview/home" : {
      "get" : {
        "operationId" : "home",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HomeOverview"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The Home tab's summary figures",
        "tags" : [ "overview" ]
      }
    },
    "/api/overview/liquidity" : {
      "get" : {
        "operationId" : "liquidity",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LiquidityOverview"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The Liquidity tab: balances, emergency fund and the three-month cash-flow forecast",
        "tags" : [ "overview" ]
      }
    },
    "/api/overview/wealth" : {
      "get" : {
        "operationId" : "wealth",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WealthOverview"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The Wealth & Retirement tab: holdings, savings plans and the goal projection",
        "tags" : [ "overview" ]
      }
    },
    "/api/persona" : {
      "get" : {
        "operationId" : "current",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PersonaResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The persona of the current session",
        "tags" : [ "persona" ]
      }
    },
    "/api/provenance/{provId}" : {
      "get" : {
        "operationId" : "show",
        "parameters" : [ {
          "description" : "16 lower-case hex characters",
          "in" : "path",
          "name" : "provId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProvenanceResponse"
                }
              }
            },
            "description" : "The figure's provenance"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProvenanceResponse"
                }
              }
            },
            "description" : "Not a figure key"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProvenanceResponse"
                }
              }
            },
            "description" : "No such figure for this persona"
          }
        },
        "summary" : "Where a figure comes from: source, inputs, assumptions and checks",
        "tags" : [ "provenance" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AssessmentAnswer" : {
        "type" : "object",
        "description" : "The answer to one question: a choice key, an amount or number as a decimal string, or a short text",
        "properties" : {
          "key" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "[a-z_]{1,64}"
          },
          "value" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "key", "value" ]
      },
      "CalculateRequest" : {
        "type" : "object",
        "description" : "Calculate a proposal, with the values the persona changed",
        "properties" : {
          "parameters" : {
            "type" : "array",
            "description" : "Only the changed values; empty or missing to calculate as proposed",
            "items" : {
              "$ref" : "#/components/schemas/ChangedValue"
            },
            "maxItems" : 10,
            "minItems" : 0
          }
        }
      },
      "ChangedValue" : {
        "type" : "object",
        "description" : "A value the persona changed, in the parameter's unit (a rate as a fraction: 0.04 = 4 %)",
        "properties" : {
          "key" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          },
          "value" : {
            "type" : "string",
            "maxLength" : 32,
            "minLength" : 0,
            "pattern" : "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required" : [ "key", "value" ]
      },
      "Chat" : {
        "type" : "object",
        "description" : "The conversation, oldest message first",
        "properties" : {
          "messages" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ChatMessage"
            }
          },
          "personaName" : {
            "type" : "string",
            "description" : "The name the greeting uses"
          }
        },
        "required" : [ "messages", "personaName" ]
      },
      "ChatAssessment" : {
        "type" : "object",
        "description" : "The assessment card: every open profile question in one form",
        "properties" : {
          "fields" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ChatAssessmentField"
            }
          },
          "status" : {
            "type" : "string",
            "description" : "OPEN: waiting for Save my answers; SAVED: answered below; CANCELLED: a later question replaced it",
            "enum" : [ "OPEN", "SAVED", "CANCELLED" ]
          }
        },
        "required" : [ "fields", "status" ]
      },
      "ChatAssessmentField" : {
        "type" : "object",
        "description" : "One question of the assessment card",
        "properties" : {
          "input" : {
            "type" : "string",
            "description" : "CHOICE: choice chips; EUR: amount in euros; NUMBER: whole number; SLIDER: options from the lower to the upper end; TEXT: short text",
            "enum" : [ "CHOICE", "EUR", "NUMBER", "SLIDER", "TEXT" ]
          },
          "key" : {
            "type" : "string",
            "description" : "The key to answer it by"
          },
          "label" : {
            "type" : "string"
          },
          "max" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Largest NUMBER or EUR value, or the longest TEXT"
          },
          "min" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Smallest NUMBER or EUR value"
          },
          "options" : {
            "type" : "array",
            "description" : "The choices of CHOICE and SLIDER; empty otherwise",
            "items" : {
              "$ref" : "#/components/schemas/ChatAssessmentOption"
            }
          },
          "provId" : {
            "type" : "string",
            "description" : "The figure a pre-filled value is; only on pre-filled questions",
            "pattern" : "^[0-9a-f]{16}$"
          },
          "unit" : {
            "type" : "string",
            "description" : "The unit after a NUMBER field, e.g. years"
          },
          "value" : {
            "type" : "string",
            "description" : "The value from your account data, as a decimal string; only on pre-filled questions",
            "pattern" : "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required" : [ "input", "key", "label", "max", "min", "options" ]
      },
      "ChatAssessmentOption" : {
        "type" : "object",
        "description" : "One choice of an assessment question",
        "properties" : {
          "key" : {
            "type" : "string",
            "description" : "The value to answer with"
          },
          "label" : {
            "type" : "string"
          }
        },
        "required" : [ "key", "label" ]
      },
      "ChatCheck" : {
        "type" : "object",
        "description" : "One check on Fine's answer",
        "properties" : {
          "description" : {
            "type" : "string",
            "description" : "What the check makes sure of, in plain words"
          },
          "id" : {
            "type" : "string",
            "description" : "Shown only as a small caption",
            "enum" : [ "SCOPE", "PROFILE_COMPLETE", "SUITABILITY", "COST_TRANSPARENCY", "NO_PRODUCT_NAMING", "NO_GUARANTEE_OR_TIMING", "CONFLICT_OF_INTEREST", "IDD_NEEDS", "DOCUMENTATION", "NUMBER_MATCH", "SOURCE_VALIDITY" ]
          },
          "passed" : {
            "type" : "boolean"
          }
        },
        "required" : [ "description", "id", "passed" ]
      },
      "ChatHandover" : {
        "type" : "object",
        "description" : "What the card shows of a case for a human advisor",
        "properties" : {
          "reason" : {
            "type" : "string",
            "description" : "A plain reason class, e.g. \"because I couldn't confirm every figure in my answer\"; null when there is none"
          },
          "status" : {
            "type" : "string",
            "description" : "OPEN: waiting for the advisor; CLOSED: answered",
            "enum" : [ "OPEN", "CLOSED" ]
          }
        },
        "required" : [ "status" ]
      },
      "ChatMessage" : {
        "type" : "object",
        "description" : "One message of the conversation",
        "properties" : {
          "assessment" : {
            "$ref" : "#/components/schemas/ChatAssessment",
            "description" : "The form with every profile question still open; only on ASK_PROFILE answers"
          },
          "author" : {
            "type" : "string",
            "enum" : [ "USER", "AGENT", "ADVISOR" ]
          },
          "checks" : {
            "type" : "array",
            "description" : "The checks Fine's answer passed or failed, shown under \"Checks\"; empty on other messages and on fixed answers",
            "items" : {
              "$ref" : "#/components/schemas/ChatCheck"
            }
          },
          "figures" : {
            "type" : "array",
            "description" : "The figures a calculated answer used, shown as figure chips; empty on other messages",
            "items" : {
              "$ref" : "#/components/schemas/Figure"
            }
          },
          "handover" : {
            "$ref" : "#/components/schemas/ChatHandover",
            "description" : "The case for a human advisor; only on answers passed to an advisor (ESCALATE)"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "outcome" : {
            "type" : "string",
            "description" : "How the turn ended; only on Fine's answers",
            "enum" : [ "INFORM", "ASK_PROFILE", "RECOMMEND_CATEGORY", "COMPUTE", "REFUSE_OUT_OF_SCOPE", "DETECT_TRAP", "ESCALATE" ]
          },
          "premise" : {
            "type" : "string",
            "description" : "The false assumption a question makes, in one sentence; only on DETECT_TRAP answers"
          },
          "proposal" : {
            "$ref" : "#/components/schemas/ChatProposal",
            "description" : "\"Here's what I understood\": the values a calculation will run with; only on COMPUTE answers that ask before calculating"
          },
          "replyTo" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "The question an answer replies to; only on Fine's answers"
          },
          "suggestions" : {
            "type" : "array",
            "description" : "Suggestion chips of Fine's answer: question texts that send themselves; empty on other messages",
            "items" : {
              "type" : "string"
            },
            "maxItems" : 3
          },
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "author", "checks", "figures", "id", "suggestions", "text" ]
      },
      "ChatProposal" : {
        "type" : "object",
        "description" : "The values a calculation will run with, shown before calculating",
        "properties" : {
          "parameters" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ChatProposalParameter"
            }
          },
          "status" : {
            "type" : "string",
            "description" : "OPEN: waiting for Calculate; CALCULATED: answered below; CANCELLED: a later question replaced it",
            "enum" : [ "OPEN", "CALCULATED", "CANCELLED" ]
          }
        },
        "required" : [ "parameters", "status" ]
      },
      "ChatProposalParameter" : {
        "type" : "object",
        "description" : "One value of a proposed calculation",
        "properties" : {
          "key" : {
            "type" : "string",
            "description" : "The key to change it by"
          },
          "label" : {
            "type" : "string"
          },
          "provId" : {
            "type" : "string",
            "description" : "The figure an account-data value is; only for ACCOUNT_DATA",
            "pattern" : "^[0-9a-f]{16}$"
          },
          "source" : {
            "type" : "string",
            "description" : "QUESTION: from your question; ACCOUNT_DATA: from your account data; CHANGED: changed by you",
            "enum" : [ "QUESTION", "ACCOUNT_DATA", "CHANGED" ]
          },
          "unit" : {
            "type" : "string",
            "enum" : [ "EUR", "FRACTION", "PP", "MONTHS", "YEARS", "COUNT" ]
          },
          "value" : {
            "type" : "string",
            "description" : "Decimal string",
            "pattern" : "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required" : [ "key", "label", "source", "unit", "value" ]
      },
      "DatedFigure" : {
        "type" : "object",
        "description" : "A balance on a day, e.g. the first forecast day below zero",
        "properties" : {
          "amount" : {
            "$ref" : "#/components/schemas/Figure"
          },
          "date" : {
            "type" : "string",
            "format" : "date"
          },
          "wholeEuros" : {
            "type" : "string",
            "description" : "The amount rounded to whole euros (half up), for the chart marker and running text",
            "example" : "-90",
            "pattern" : "^-?\\d+$"
          }
        },
        "required" : [ "amount", "date", "wholeEuros" ]
      },
      "EmergencyFund" : {
        "type" : "object",
        "description" : "The emergency fund (overnight deposit) against its target",
        "properties" : {
          "current" : {
            "$ref" : "#/components/schemas/Figure"
          },
          "monthlyExpenses" : {
            "$ref" : "#/components/schemas/Figure"
          },
          "months" : {
            "$ref" : "#/components/schemas/Figure",
            "description" : "Months of expenses in the target"
          },
          "target" : {
            "$ref" : "#/components/schemas/Figure",
            "description" : "Minimum target"
          },
          "targetMax" : {
            "$ref" : "#/components/schemas/Figure"
          }
        },
        "required" : [ "current", "monthlyExpenses", "months", "target", "targetMax" ]
      },
      "Figure" : {
